# ---- RideWise Assist environment ----
# Copy to .env and fill in. NEVER commit .env.

# LLM (NeoStats-hosted, OpenAI-compatible). Values shared at the event.
LLM_BASE_URL=https://neo-hackathon.services.ai.azure.com/openai/v1/
LLM_API_KEY=
LLM_MODEL=Neo-Hackathon
# gpt-oss is a reasoning model; keep effort low for latency/cost.
LLM_REASONING_EFFORT=low

# Paths (defaults are fine)
DB_PATH=data/ridewise.db
DOCS_DIR=data
INDEX_DIR=data/index
TRANSCRIPTIONS_DIR=data/transcriptions

# Retrieval
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Optional Supabase pgvector store. If unset, local numpy+BM25 store is used.
SUPABASE_DB_URL=

# Optional features (default OFF, require organiser approval)
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=

# Tracing (default OFF; keep off for demo)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
